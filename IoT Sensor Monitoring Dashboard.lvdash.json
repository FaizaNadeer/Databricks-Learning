{
  "datasets": [
    {
      "name": "566ce5a1",
      "displayName": "sensor_windows",
      "queryLines": [
        "SELECT\r\n",
        "  time_window.start AS window_start,\r\n",
        "  device_id,\r\n",
        "  avg_temp,\r\n",
        "  avg_humidity\r\n",
        "FROM gold_sensor_5min_avg\r\n",
        "ORDER BY window_start, device_id;"
      ]
    },
    {
      "name": "a86ac16a",
      "displayName": "sensor_overall",
      "queryLines": [
        "SELECT device_id, count(*) AS window_count, avg(avg_temp) AS overall_avg_temp FROM gold_sensor_5min_avg GROUP BY device_id ORDER BY device_id"
      ]
    }
  ],
